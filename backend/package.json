{
  "name": "fluxo-backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "prisma:studio": "prisma studio",
    "pretest": "cross-env DATABASE_URL=postgresql://fluxo:fluxo@localhost:5432/fluxo_test prisma migrate deploy",
    "test": "cross-env DATABASE_URL=postgresql://fluxo:fluxo@localhost:5432/fluxo_test JWT_SECRET=test-secret-key FRONTEND_URL=http://localhost:3000 jest --runInBand"
  },
  "dependencies": {
    "@prisma/client": "^5.20.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "socket.io": "^4.7.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.14.0",
    "@types/supertest": "^7.2.1",
    "cross-env": "^10.1.0",
    "jest": "^30.5.1",
    "prisma": "^5.20.0",
    "socket.io-client": "^4.8.3",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4"
  }
}
