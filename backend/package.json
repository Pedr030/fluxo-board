{
  "name": "fluxo-backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "prisma migrate deploy && node dist/index.js",
    "prisma:studio": "prisma studio",
    "pretest": "cross-env DATABASE_URL=postgresql://fluxo:fluxo@localhost:5432/fluxo_test prisma migrate deploy",
    "test": "cross-env DATABASE_URL=postgresql://fluxo:fluxo@localhost:5432/fluxo_test JWT_SECRET=test-secret-key FRONTEND_URL=http://localhost:3000 jest --runInBand"
  },
  "overrides": {
    "qs": "^6.16.0",
    "deepmerge-ts": "^8.0.2"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.3.0",
    "socket.io": "^4.7.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.20.3",
    "@types/supertest": "^7.2.1",
    "cross-env": "^10.1.0",
    "jest": "^30.5.1",
    "prisma": "^6.19.3",
    "socket.io-client": "^4.8.3",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "tsx": "^4.16.2",
    "typescript": "^6.0.3"
  }
}
