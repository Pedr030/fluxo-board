generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// TODO: este é o modelo mínimo para o MVP. Sinta-se livre de evoluir
// (labels, comentários, anexos, activity log) conforme o roadmap do
// PROJECT_SPEC.md avançar.

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  avatarUrl String?
  createdAt DateTime @default(now())

  memberships         BoardMember[]
  ownedBoards         Board[]       @relation("BoardOwner")
  cardsCreated        Card[]        @relation("CardCreator")
  commentsWritten     Comment[]     @relation("CommentAuthor")
  attachmentsUploaded Attachment[]  @relation("AttachmentUploader")
}

model Board {
  id        String   @id @default(cuid())
  title     String
  ownerId   String
  owner     User     @relation("BoardOwner", fields: [ownerId], references: [id])
  createdAt DateTime @default(now())

  members BoardMember[]
  lists   List[]
}

enum Role {
  OWNER
  MEMBER
}

model BoardMember {
  id      String @id @default(cuid())
  boardId String
  userId  String
  role    Role   @default(MEMBER)

  board Board @relation(fields: [boardId], references: [id], onDelete: Cascade)
  // onDelete: Cascade aqui (e não em Board.owner) é proposital — excluir a
  // conta precisa primeiro transferir ou excluir cada board que a pessoa é
  // dona (ver deleteAccount em me.controller.ts); só a participação como
  // membro comum some sozinha.
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([boardId, userId])
}

model List {
  id       String @id @default(cuid())
  title    String
  position Int
  boardId  String

  board Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)
  cards Card[]
}

model Card {
  id          String   @id @default(cuid())
  title       String
  description String?
  position    Int
  listId      String
  creatorId   String?
  createdAt   DateTime @default(now())

  list List @relation(fields: [listId], references: [id], onDelete: Cascade)
  // SetNull, não Cascade: excluir a conta de quem criou um card não deveria
  // apagar o card em si (que pode estar num board de outra pessoa) — só
  // perde a atribuição de quem criou.
  creator     User?        @relation("CardCreator", fields: [creatorId], references: [id], onDelete: SetNull)
  comments    Comment[]
  attachments Attachment[]
}

model Comment {
  id        String   @id @default(cuid())
  text      String
  cardId    String
  authorId  String?
  createdAt DateTime @default(now())

  // Cascade aqui (diferente do autor): excluir o card deveria levar os
  // comentários junto, é conteúdo dele — diferente de excluir a CONTA de
  // quem comentou, que só perde a atribuição (mesmo padrão do Card.creator).
  card   Card  @relation(fields: [cardId], references: [id], onDelete: Cascade)
  author User? @relation("CommentAuthor", fields: [authorId], references: [id], onDelete: SetNull)
}

model Attachment {
  id         String   @id @default(cuid())
  cardId     String
  uploaderId String?
  filename   String
  mimeType   String
  size       Int
  url        String
  createdAt  DateTime @default(now())

  // Mesma lógica do Comment: apagar o card leva os anexos junto (Cascade),
  // apagar a conta de quem subiu só perde a atribuição (SetNull) — o
  // arquivo em si no Supabase Storage é removido explicitamente no
  // controller antes de excluir a linha, não por trigger do banco.
  card     Card  @relation(fields: [cardId], references: [id], onDelete: Cascade)
  uploader User? @relation("AttachmentUploader", fields: [uploaderId], references: [id], onDelete: SetNull)
}
