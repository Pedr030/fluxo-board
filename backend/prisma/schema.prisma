generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  avatarUrl String?
  createdAt DateTime @default(now())

  memberships         BoardMember[]
  ownedBoards         Board[]       @relation("BoardOwner")
  cardsCreated        Card[]        @relation("CardCreator")
  cardsAssigned       Card[]        @relation("CardAssignee")
  commentsWritten     Comment[]     @relation("CommentAuthor")
  attachmentsUploaded Attachment[]  @relation("AttachmentUploader")
  activities          Activity[]    @relation("ActivityActor")
}

model Board {
  id        String   @id @default(cuid())
  title     String
  ownerId   String
  owner     User     @relation("BoardOwner", fields: [ownerId], references: [id])
  createdAt DateTime @default(now())

  members    BoardMember[]
  lists      List[]
  labels     Label[]
  activities Activity[]
}

enum Role {
  OWNER
  // Tudo que MEMBER pode + convidar gente nova. Não é "mais confiável que
  // MEMBER" em relação aos próprios cards — a restrição de "só edita os
  // próprios cards" (campo `restricted` abaixo) é uma dimensão separada
  // do cargo, não amarrada a ele. Só o OWNER promove/rebaixa ADMIN
  // (ver updateMember em board.controller.ts) — a própria conta OWNER
  // não muda de cargo por aqui (isso é a exclusão de conta com
  // transferência de posse, um fluxo à parte).
  ADMIN
  MEMBER
}

model BoardMember {
  id      String @id @default(cuid())
  boardId String
  userId  String
  role    Role   @default(MEMBER)
  // Quando true, essa pessoa só pode editar/mover/excluir cards que
  // estejam atribuídos a ela (ou sem responsável nenhum — "livres pra
  // pegar"). Não afeta comentar, checklist, etiquetas nem anexos, que
  // continuam abertos pra qualquer membro. Só faz sentido em MEMBER —
  // promover alguém a ADMIN limpa essa flag (ver updateMember).
  restricted Boolean @default(false)

  board Board @relation(fields: [boardId], references: [id], onDelete: Cascade)
  // onDelete: Cascade aqui (e não em Board.owner) é proposital — excluir a
  // conta precisa primeiro transferir ou excluir cada board que a pessoa é
  // dona (ver deleteAccount em me.controller.ts); só a participação como
  // membro comum some sozinha.
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([boardId, userId])
}

model List {
  id       String @id @default(cuid())
  title    String
  position Int
  boardId  String

  board Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)
  cards Card[]
}

model Card {
  id          String    @id @default(cuid())
  title       String
  description String?
  position    Int
  listId      String
  creatorId   String?
  assigneeId  String?
  createdAt   DateTime  @default(now())
  dueDate     DateTime?
  completed   Boolean   @default(false)

  list List @relation(fields: [listId], references: [id], onDelete: Cascade)
  // SetNull, não Cascade: excluir a conta de quem criou um card não deveria
  // apagar o card em si (que pode estar num board de outra pessoa) — só
  // perde a atribuição de quem criou. Mesma lógica pro responsável
  // (assignee): a pessoa saiu, o card continua existindo, só fica sem
  // responsável designado.
  creator        User?           @relation("CardCreator", fields: [creatorId], references: [id], onDelete: SetNull)
  assignee       User?           @relation("CardAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  comments       Comment[]
  attachments    Attachment[]
  cardLabels     CardLabel[]
  checklistItems ChecklistItem[]
}

model Comment {
  id        String   @id @default(cuid())
  text      String
  cardId    String
  authorId  String?
  createdAt DateTime @default(now())

  // Cascade aqui (diferente do autor): excluir o card deveria levar os
  // comentários junto, é conteúdo dele — diferente de excluir a CONTA de
  // quem comentou, que só perde a atribuição (mesmo padrão do Card.creator).
  card   Card  @relation(fields: [cardId], references: [id], onDelete: Cascade)
  author User? @relation("CommentAuthor", fields: [authorId], references: [id], onDelete: SetNull)
}

model Attachment {
  id         String   @id @default(cuid())
  cardId     String
  uploaderId String?
  filename   String
  mimeType   String
  size       Int
  url        String
  createdAt  DateTime @default(now())

  // Mesma lógica do Comment: apagar o card leva os anexos junto (Cascade),
  // apagar a conta de quem subiu só perde a atribuição (SetNull) — o
  // arquivo em si no Supabase Storage é removido explicitamente no
  // controller antes de excluir a linha, não por trigger do banco.
  card     Card  @relation(fields: [cardId], references: [id], onDelete: Cascade)
  uploader User? @relation("AttachmentUploader", fields: [uploaderId], references: [id], onDelete: SetNull)
}

// Etiquetas coloridas do board (a paleta é compartilhada por todos os
// cards dele, igual Trello — criar/editar uma etiqueta muda a cor em
// todo card que já usa ela). `name` é opcional: dá pra ter só uma cor,
// sem texto, também igual Trello.
model Label {
  id      String  @id @default(cuid())
  boardId String
  name    String?
  color   String

  board Board       @relation(fields: [boardId], references: [id], onDelete: Cascade)
  cards CardLabel[]
}

// Tabela de junção Card↔Label (N:N). Sem onDelete: SetNull pra pensar
// aqui — não tem "autor" nessa relação, só as duas pontas, e as duas
// fazem sentido em Cascade: card ou label sumindo, a associação não tem
// mais motivo pra existir.
model CardLabel {
  cardId  String
  labelId String

  card  Card  @relation(fields: [cardId], references: [id], onDelete: Cascade)
  label Label @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([cardId, labelId])
}

// Um item de checklist do card (subtarefa com checkbox). Sem "autor" —
// igual etiqueta, é conteúdo colaborativo do card, qualquer membro do
// board mexe. Sem uma entidade "Checklist" separada de propósito: um
// card só tem uma lista de itens, não várias como o Trello de verdade
// permite — mais simples, e cobre o que foi pedido.
model ChecklistItem {
  id       String  @id @default(cuid())
  cardId   String
  text     String
  done     Boolean @default(false)
  position Int

  card Card @relation(fields: [cardId], references: [id], onDelete: Cascade)
}

// Histórico de atividade do board (quem fez o quê e quando). `summary` é
// texto já pronto pra exibir ("criou o card \"X\" na lista \"Y\""), gerado
// no controller no momento da ação — não guarda referência a Card/List
// (só a boardId), de propósito: a atividade precisa continuar existindo
// e fazendo sentido mesmo depois que o card/lista em questão for excluído,
// então vira um "retrato" congelado, não uma junção viva. `userId` é
// SetNull (mesmo padrão de Comment/Attachment) — perde a atribuição, não
// a entrada em si, se a conta de quem fez for excluída. Nem toda mutação
// gera entrada aqui — só eventos de ciclo de vida de alto sinal (criar/
// mover/excluir card e lista, comentário, convite, concluir/reabrir),
// senão o histórico vira ruído.
model Activity {
  id        String   @id @default(cuid())
  boardId   String
  userId    String?
  summary   String
  createdAt DateTime @default(now())

  board Board @relation(fields: [boardId], references: [id], onDelete: Cascade)
  user  User? @relation("ActivityActor", fields: [userId], references: [id], onDelete: SetNull)
}
