# Postgres (docker-compose local ou Supabase/Neon/Railway em produção)
DATABASE_URL="postgresql://fluxo:fluxo@localhost:5432/fluxo"

# Segredo para assinar os JWTs de autenticação — troque por um valor aleatório longo
JWT_SECRET="troque-por-uma-string-aleatoria-bem-grande"

# Porta do servidor HTTP/WebSocket
PORT=4000

# URL do frontend, usada para configurar CORS
FRONTEND_URL="http://localhost:3000"
